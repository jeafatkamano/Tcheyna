# ─── Application ────────────────────────────────────────────
FLASK_ENV=development
FLASK_DEBUG=true
# En production (FLASK_ENV=production), l'API refuse de démarrer si l'une de
# ces clés est absente, fait moins de 32 caractères ou vaut l'exemple ci-dessous.
# Générer : python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=changez-moi-en-production
JWT_SECRET_KEY=changez-moi-aussi-en-production
# Facultatif (vide : dérivé de SECRET_KEY) ; s'il est fourni, mêmes règles.
# OTP_HMAC_KEY=

# ─── Base de données ────────────────────────────────────────
# Local  : laisser vide → SQLite (backend/tcheyna.sqlite)
# Prod   : URL Supabase (Settings → Database → Connection string → URI)
# DATABASE_URL=postgresql://postgres:MOTDEPASSE@db.PROJET.supabase.co:5432/postgres

# ─── CORS : origines autorisées du frontend, séparées par des virgules ──
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ─── Fichiers téléversés ────────────────────────────────────
UPLOAD_FOLDER=uploads

# ─── Stockage des fichiers (Supabase Storage) ───────────────
# Laisser vide en dev : les fichiers vont dans UPLOAD_FOLDER.
# En production, ces valeurs sont obligatoires — sinon les téléversements
# sont refusés, plutôt qu'écrits sur un disque éphémère.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET_PUBLIC=tcheyna-photos
SUPABASE_BUCKET_PRIVE=tcheyna-documents

# ─── Conservation des pièces (décision D5) ──────────────────
# Jours après lesquels une pièce restée sans décision est purgée par
# `flask donnees purger-pieces` (décision D5 : 365). Vide ou 0 : purge désactivée.
DUREE_CONSERVATION_PIECES_JOURS=365

# ─── Tâches nocturnes (cron-job.org) ────────────────────────
# Jeton de POST /api/interne/taches-nocturnes (en-tête X-Taches-Jeton).
# Vide : route désactivée (404). Fourni : 32 caractères au moins, comme les
# autres secrets. Générer : python -c "import secrets; print(secrets.token_urlsafe(48))"
TACHES_NOCTURNES_JETON=

# ─── Africa's Talking (OTP SMS) ─────────────────────────────
# Laisser AT_API_KEY vide en dev : le code OTP est renvoyé par l'API.
AT_API_KEY=
AT_USERNAME=sandbox
AT_SENDER_ID=TCHEYNA

# ─── CinetPay (Mobile Money) ────────────────────────────────
# Laisser CINETPAY_API_KEY vide en dev : les paiements restent « en attente ».
CINETPAY_API_KEY=
CINETPAY_SITE_ID=
CINETPAY_NOTIFY_URL=http://localhost:5000/api/payments/callback
CINETPAY_RETURN_URL=http://localhost:5173/paiements
